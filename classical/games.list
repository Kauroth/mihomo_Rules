# classical：装 domain 规则集装不下的东西（keyword / regexp / 进程）
DOMAIN-KEYWORD,epicgames
DOMAIN-KEYWORD,steambroadcast
DOMAIN-KEYWORD,steamstore
DOMAIN-KEYWORD,steamuserimages
DOMAIN-REGEX,^cdn\d-epicgames-\d+\.file\.myqcloud\.com$
DOMAIN-REGEX,^epicgames-download\d-\d+\.file\.myqcloud\.com$
DOMAIN-REGEX,^epicgames-download\d\.akamaized\.net$
